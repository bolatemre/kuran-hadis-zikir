    <item>
        <shape android:shape="rectangle"><solid android:color="@color/ucnur_alt" /></shape>
    </item>
    <item android:gravity="top" android:height="160dp">
        <shape android:shape="rectangle"><solid android:color="@color/ucnur_ust" /></shape>
    </item>
</layer-list>
