<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_zemin"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_konum" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="Üç Nur" />
            <TextView android:id="@+id/w_tarih" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#DDE9D9A8" android:textSize="11sp" android:maxLines="2" android:text="" />
            <TextView android:id="@+id/w_hicri" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#DDE9D9A8" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:text="" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/w_etiket" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E8C46E" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:text="" />
            <Chronometer android:id="@+id/w_sayac" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar android:id="@+id/w_ilerleme" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="7dp" android:max="1000" android:progress="0" android:progressDrawable="@drawable/widget_ilerleme" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
        <LinearLayout android:id="@+id/w_kol0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/w_ad0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCDFE9E3" android:textSize="11sp" android:maxLines="1" android:text="-" />
            <TextView android:id="@+id/w_saat0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:text="--:--" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_kol1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/w_ad1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCDFE9E3" android:textSize="11sp" android:maxLines="1" android:text="-" />
            <TextView android:id="@+id/w_saat1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:text="--:--" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_kol2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/w_ad2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCDFE9E3" android:textSize="11sp" android:maxLines="1" android:text="-" />
            <TextView android:id="@+id/w_saat2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:text="--:--" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_kol3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/w_ad3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCDFE9E3" android:textSize="11sp" android:maxLines="1" android:text="-" />
            <TextView android:id="@+id/w_saat3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:text="--:--" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_kol4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/w_ad4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCDFE9E3" android:textSize="11sp" android:maxLines="1" android:text="-" />
            <TextView android:id="@+id/w_saat4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:text="--:--" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_kol5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/w_ad5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCDFE9E3" android:textSize="11sp" android:maxLines="1" android:text="-" />
            <TextView android:id="@+id/w_saat5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:text="--:--" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
