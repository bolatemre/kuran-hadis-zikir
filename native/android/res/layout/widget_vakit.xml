    android:padding="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_konum" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="Üç Nur" />
            <TextView android:id="@+id/w_tarih" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCDFE9E3" android:textSize="12sp" android:maxLines="2" android:text="" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/w_etiket" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E8C46E" android:textSize="12sp" android:maxLines="1" android:text="" />
